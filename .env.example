# AStock 配置文件
# 复制本文件为 .env 后填写真实值

# ---------- 数据 ----------
ASTOCK_CACHE_DIR=/root/.astock/cache
ASTOCK_DB_PATH=/root/.astock/astock.db
ASTOCK_CACHE_TTL=300
ASTOCK_HISTORY_DAYS=60
# 数据源优先级（逗号分隔）
ASTOCK_SOURCE_PRIORITY=tushare,baostock,yahoo,akshare
# 数据源开关
ASTOCK_ENABLE_AKSHARE=true
ASTOCK_ENABLE_BAOSTOCK=true
ASTOCK_ENABLE_TUSHARE=false
ASTOCK_ENABLE_YAHOO=true
# Tushare Pro Token（如需启用）
TUSHARE_TOKEN=your_token_here

# ---------- 风控 ----------
ASTOCK_MAX_POS=0.20
ASTOCK_STOP_LOSS=0.07
ASTOCK_STOP_PROFIT=0.15

# ---------- 策略开关 ----------
ASTOCK_FB=true
ASTOCK_CB=true

# ---------- 推送 ----------
# 钉钉机器人
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET=SECxxx

# 飞书机器人
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx

# 企业微信机器人
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 是否开启推送
ASTOCK_PUSH=true
